<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jonathancruzate.metamuseandroidauto">

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <queries>
        <package android:name="com.facebook.aura" />
    </queries>

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v2.5.2: hold the screen on briefly during the wake
         trampoline (screen-off Talk / hang-up). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Muse for Android Auto"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">

        <!-- Android Auto media app declaration -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v2.5.2: wake trampoline — wakes the phone and shows
             over the lock screen so the accessibility voice /
             end-call taps can land when Talk or Hang up is pressed
             with the screen off. Not exported; launched only by
             SessionControl via explicit intent. -->
        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".DriveMediaService"
            android:label="Muse for Android Auto"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <service
            android:name=".DriveAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/drive_accessibility_config" />
        </service>

        <receiver
            android:name=".DriveReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jonathancruzate.metamuseandroidauto.TALK" />
                <action android:name="com.jonathancruzate.metamuseandroidauto.MUTE" />
                <action android:name="com.jonathancruzate.metamuseandroidauto.UNMUTE" />
                <action android:name="com.jonathancruzate.metamuseandroidauto.END" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
